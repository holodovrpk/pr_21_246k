<Window x:Class="pr_21_246k.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_21_246k"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <DataGrid x:Name="tableProduct" Height="200" Margin="10"
                  AutoGenerateColumns="False">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Width="300" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Цена" Width="120" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Количество" Width="120" Binding="{Binding Count}"/>
            </DataGrid.Columns>
            
        </DataGrid>
        
    </StackPanel>
</Window>
